function renderPresidentCareer(){
  const log = document.getElementById('work-log'); if(!log) return;
  const now = Date.now();
  if(S.presidentStage === 0) {
    log.innerHTML = `<div style="color:#f59e0b;font-weight:800;margin-bottom:5px">⚖️ Карьера Президента</div><div style="font-size:12px;color:#8a929b;margin-bottom:10px">Чтобы стать Президентом, нужно пройти 5 этапов.</div><button onclick="startPresidentStage()" style="background:#000;color:#fff">Начать карьеру (Этап 1)</button>`; return;
  }
  const current = PRESIDENT_STAGES.find(s=>s.stage===S.presidentStage); if(!current) return;
  if(S.presidentWaitUntil > now) {
    const left = Math.ceil((S.presidentWaitUntil - now)/60000);
    log.innerHTML = `<div style="color:#f59e0b;font-weight:800">⏳ Ожидание проверки: ${current.name}</div><div style="font-size:12px;color:#8a929b;margin-top:5px">Осталось: ~${left} мин.</div>`; return;
  }
  if(S.presidentApproved) {
    if(S.presidentStage === 5) { log.innerHTML = `<div style="color:#00c853;font-weight:800">👑 Вы Президент!</div><div style="font-size:12px;color:#8a929b;margin-top:5px">Смена приносит 50 000 ₽ / час.</div>`; }
    else {
      const next = PRESIDENT_STAGES.find(s=>s.stage===S.presidentStage+1);
      log.innerHTML = `<div style="color:#00c853;font-weight:800">✅ Одобрено: ${current.name}</div><div style="font-size:12px;color:#8a929b;margin-bottom:10px">Следующий этап: ${next.name} (взнос: ${fmt(next.cost)} ₽)</div><button onclick="startPresidentStage()" style="background:#000;color:#fff">Подать заявку на ${next.name}</button>`;
    } return;
  }
  log.innerHTML = `<div style="color:#ff3b30;font-weight:800">❌ Отказ: ${current.name}</div><div style="font-size:12px;color:#8a929b;margin-bottom:10px">Вам отказано. Попробуйте снова (взнос: ${fmt(current.cost)} ₽).</div><button onclick="startPresidentStage()" style="background:#ff3b30;color:#fff">Подать снова</button>`;
}
function startPresidentStage(){
  let stage = S.presidentStage + 1; if(S.presidentStage === 0) stage = 1;
  const req = PRESIDENT_STAGES.find(s=>s.stage===stage); if(!req) return;
  if(!hasAllDocs(req.docs)){ toast('Нужны документы: '+missingDocs(req.docs).join(', ')); return; }
  if(S.balance < req.cost){ toast('Нужен взнос: '+fmt(req.cost)+' ₽'); return; }
  changeBalance(-req.cost); S.presidentStage = stage; S.presidentApproved = false; S.presidentWaitUntil = Date.now() + (req.waitMin * 60 * 1000);
  toast('Заявка подана. Ожидайте ' + req.waitMin + ' мин.');
  renderAll(); save();
}

function renderWork(){
  const el=document.getElementById('work-list'); if(!el) return; calcLimit();
  const pb = premiumBonus();
  el.innerHTML=WORK_JOBS.map(j=>{
    const okDocs=hasAllDocs(j.req); const disabled = S.creditOverdue || S.job || !okDocs; const missing = missingDocs(j.req);
    const pay = Math.floor(j.pay * (1 + ((S.salaryBoost||0)+pb.salary)/100));
    return `<div class="list-item"><div class="list-icon">${j.icon}</div><div class="list-info"><div class="list-name">${j.name}</div><div class="list-desc">${fmt(pay)} ₽ / час (5 мин)</div>${!okDocs?`<div class="list-desc" style="color:#ff3b30">Нужно: ${missing.join(', ')}</div>`:''}</div>${j.president && S.presidentStage < 5 ? `<button style="width:auto;padding:0 14px;height:38px;font-size:12px;background:#f59e0b;color:#000" onclick="renderPresidentCareer()">Карьера</button>` : `<button style="width:auto;padding:0 14px;height:38px;font-size:12px" ${disabled?'disabled':''} onclick="doWork('${j.id}')">Работать</button>`}</div>`;
  }).join('');
  if(S.creditOverdue){ el.innerHTML+=`<div style="margin-top:10px;padding:12px;background:#ffe5e5;border-radius:12px;font-size:12px;color:#b00020;font-weight:700">Работодатели отвернулись из-за просрочки кредита.</div>`; }
  renderPresidentCareer();
  const quitBtn = document.getElementById('quit-job-btn');
  if(quitBtn) { const hasActive = S.workBook.some(r => r.active); quitBtn.style.display = hasActive ? 'block' : 'none'; }
