function doWork(id){
  if(S.creditOverdue){ toast('Работа недоступна: просрочка кредита'); return; }
  if(Date.now()<(S.jobBlockUntil||0)){ toast('Работы заблокированы'); return; }
  if((S.energy||100) < 20){ toast('Мало энергии (нужно 20)'); return; }
  if(S.job){ toast('Ты уже на смене'); return; }
  const job=WORK_JOBS.find(j=>j.id===id); if(!job) return;
  if(job.president && (S.presidentStage < 5 || !S.presidentApproved)){ toast('Вы ещё не Президент.'); return; }
  if(!hasAllDocs(job.req)){ toast('Нужны документы: '+missingDocs(job.req).join(', ')); return; }
  S.job=id; S.jobEnd=Date.now()+5*60*1000;
  let rec=S.workBook.find(r=>r.jobId===id && r.active);
  if(!rec){ S.workBook.forEach(r=>{ if(r.active){ r.active=false; r.fired=new Date().toLocaleDateString('ru-RU'); } }); rec={ jobId:id, jobName:job.name, icon:job.icon, started:new Date().toLocaleDateString('ru-RU'), shifts:0, earned:0, active:true }; S.workBook.unshift(rec); }
  save(); renderAll(); updateUI(); toast('Смена началась: '+job.name);
}
function completeJob(){
  if(!S.job) return; const job=WORK_JOBS.find(j=>j.id===S.job); if(!job){ S.job=null; return; }
  S.job=null; S.jobEnd=0; const pb = premiumBonus();
  const pay = Math.floor(job.pay * (1 + ((S.salaryBoost||0)+pb.salary)/100));
  changeBalance(pay); confetti(); S.energy = Math.max(0, (S.energy||100)-20);
  const rec=S.workBook.find(r=>r.jobId===job.id && r.active); if(rec){ rec.shifts++; rec.earned+=pay; }
  toast('Смена окончена: +'+fmt(pay)+' ₽'); save(); renderAll();
}
function quitJob(){
  if(!confirm('Вы точно хотите уволиться?')) return;
  S.workBook.forEach(r=>{ if(r.active){ r.active=false; r.fired=new Date().toLocaleDateString('ru-RU'); } });
  S.job = null; S.jobEnd = 0; toast('Вы уволились'); renderAll(); save();
}function getEarnings(){ return WORK_JOBS.reduce((a,j)=>a+j.pay,0); }
function renderCredit(){
  const el=document.getElementById('credit-list'); if(!el) return; calcLimit();
  const active = S.credits.map((c,i)=>{ const left=Math.max(0, Math.floor((c.due-Date.now())/1000)); const mm=Math.floor(left/60), ss=left%60; return `<div class="list-item" style="background:${left>0?'rgba(255,215,0,0.1)':'rgba(255,59,48,0.1)'};border-radius:12px;padding:12px;margin-bottom:8px"><div class="list-info"><div class="list-name">${c.icon} ${c.name}</div><div class="list-desc">Долг: ${fmt(c.remaining)} ₽ · ${left>0?'осталось '+mm+':'+String(ss).padStart(2,'0'):'ПРОСРОЧКА'}</div></div><button style="width:auto;padding:0 14px;height:38px;font-size:12px;background:#00c853;color:#fff" onclick="payCredit(${i})">Погасить</button></div>`; }).join('');
  el.innerHTML = (active || '<div style="text-align:center;color:#8a929b;padding:10px;font-size:12px">Активных кредитов нет</div>') + '<div style="font-weight:800;margin:14px 0 8px;font-size:13px">Доступные кредиты:</div>' + CREDIT_PRODUCTS.map(p=>{ const earnings=getEarnings(); const max = Math.min(Math.floor(S.creditLimit*p.maxMul), earnings); const taken = S.credits.some(c=>c.productId===p.id); return `<div class="list-item"><div class="list-icon">${p.icon}</div><div class="list-info"><div class="list-name">${p.name}</div><div class="list-desc">${p.desc}</div><div class="list-desc">Макс: ${fmt(max)} ₽</div></div>${taken?'<span style="font-size:11px;color:#f59e0b;font-weight:800">Активен</span>':`<button style="width:auto;padding:0 14px;height:38px;font-size:12px;background:#000;color:#fff" ${S.creditOverdue||max<=0?'disabled':''} onclick="takeCredit('${p.id}')">Взять</button>`}</div>`; }).join('');
