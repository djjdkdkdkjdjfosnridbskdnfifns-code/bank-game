function buyCar(i){ const c=CARS[i]; if(!c) return; if(S.balance<c.price){ toast('Недостаточно средств'); return; } changeBalance(-c.price); S.ownedCars.push(i); addHistory('Куплено авто: '+c.name, -c.price); addXP(50); toast('Куплено: '+c.name); confetti(); renderCars(); save(); }
function renderHouses(){ const el=document.getElementById('houses-list'); if(!el) return; el.innerHTML=HOUSES.map((h,i)=>`<div class="list-item"><div class="list-icon">${h.icon}</div><div class="list-info"><div class="list-name">${h.name}</div>${S.ownedHouses.includes(i)?'<div class="list-desc" style="color:#00c853">✓ Куплено</div>':''}</div>${S.ownedHouses.includes(i)?'':'<button style="width:auto;padding:0 12px;height:34px;font-size:11px" onclick="buyHouse('+i+')">'+fmt(h.price)+' ₽</button>'}</div>`).join(''); }
function buyHouse(i){ const h=HOUSES[i]; if(!h) return; if(S.balance<h.price){ toast('Недостаточно средств'); return; } changeBalance(-h.price); S.ownedHouses.push(i); addHistory('Куплен дом: '+h.name, -h.price); addXP(50); toast('Куплено: '+h.name); confetti(); renderHouses(); save(); }

function renderSocial(){ const el=document.getElementById('social-list'); if(!el) return; el.innerHTML = Object.keys(SOCIAL_PLATFORMS).map(key=>{ const p = SOCIAL_PLATFORMS[key]; const ch = S.channels[key]; if(!ch){ return `<div class="list-item"><div class="list-icon" style="color:${p.color}">${p.icon}</div><div class="list-info"><div class="list-name">${p.name}</div><div class="list-desc">Ставка: ${p.rate} ₽/просмотр</div></div><button style="width:auto;padding:0 12px;height:34px;font-size:11px" onclick="createChannel('${key}')">Завести</button></div>`; } return `<div class="list-item"><div class="list-icon" style="color:${p.color}">${p.icon}</div><div class="list-info"><div class="list-name">${p.name}: ${ch.nick}</div><div class="list-desc">Видео: ${ch.videos} · Просмотры: ${fmt(ch.totalViews)} · Монетизация: ${ch.monetized?'✅':'❌'}</div></div><div style="display:flex;flex-direction:column;gap:4px"><button style="width:auto;padding:0 10px;height:30px;font-size:11px" onclick="postVideo('${key}')">Выложить</button>${!ch.monetized?`<button style="width:auto;padding:0 10px;height:30px;font-size:11px;background:${ch.totalViews>=1000?'#00c853':'rgba(0,0,0,0.1)'};color:${ch.totalViews>=1000?'#fff':'#000'}" ${ch.totalViews>=1000?'':'disabled'} onclick="enableMonetization('${key}')">Монетизация</button>`:''}</div></div>`; }).join(''); }
function createChannel(key){ const p = SOCIAL_PLATFORMS[key]; if(!p) return; const nick = prompt('Придумай ник для '+p.name+':'); if(!nick) return; S.channels[key] = { nick: nick, videos:0, totalViews:0, monetized:false }; toast('Канал создан: '+p.name); renderSocial(); save(); }
function postVideo(key){ const ch = S.channels[key]; const p = SOCIAL_PLATFORMS[key]; if(!ch || !p) return; let views; const r = Math.random(); if(r < 0.70){ views = Math.floor(100 + Math.random()*9900); } else if(r < 0.95){ views = Math.floor(10000 + Math.random()*490000); } else if(r < 0.99){ views = Math.floor(500000 + Math.random()*4500000); } else { views = Math.floor(5000000 + Math.random()*45000000); } ch.videos++; ch.totalViews += views; let earned = 0; if(ch.monetized){ earned = Math.floor(views * p.rate); if(earned>0){ changeBalance(earned); } } toast(`${p.icon} Видео: ${fmt(views)} просмотров${ch.monetized?' · +'+fmt(earned)+' ₽':''}`); if(views>1000000) confetti(); renderSocial(); save(); }
function enableMonetization(key){ const ch = S.channels[key]; if(!ch) return; if(ch.totalViews < 1000){ toast('Нужно 1000 просмотров'); return; } ch.monetized = true; toast('Монетизация включена'); renderSocial(); save(); }

function renderCurrency(){ const el=document.getElementById('currency-list'); if(!el) return; el.innerHTML = `<div class="list-item"><div class="list-icon">💵</div><div class="list-info"><div class="list-name">Доллар (USD)</div><div class="list-desc">Курс: ${fmt(S.rates.usd)} ₽ · комиссия 2%</div></div><div style="display:flex;gap:4px"><button style="width:auto;padding:0 10px;height:30px;font-size:11px;background:#00c853;color:#fff" onclick="buyCurrency('usd')">Купить</button><button style="width:auto;padding:0 10px;height:30px;font-size:11px;background:#ff3b30;color:#fff" onclick="sellCurrency('usd')">Продать</button></div></div><div class="list-item"><div class="list-icon">💶</div><div class="list-info"><div class="list-name">Евро (EUR)</div><div class="list-desc">Курс: ${fmt(S.rates.eur)} ₽ · комиссия 2%</div></div><div style="display:flex;gap:4px"><button style="width:auto;padding:0 10px;height:30px;font-size:11px;background:#00c853;color:#fff" onclick="buyCurrency('eur')">Купить</button><button style="width:auto;padding:0 10px;height:30px;font-size:11px;background:#ff3b30;color:#fff" onclick="sellCurrency('eur')">Продать</button></div></div><div class="list-item"><div class="list-icon">🇰🇿</div><div class="list-info"><div class="list-name">Тенге (KZT)</div><div class="list-desc">Курс: ${S.rates.kzt} ₽</div></div><div style="display:flex;gap:4px"><button style="width:auto;padding:0 10px;height:30px;font-size:11px;background:#00c853;color:#fff" onclick="buyCurrency('kzt')">Купить</button><button style="width:auto;padding:0 10px;height:30px;font-size:11px;background:#ff3b30;color:#fff" onclick="sellCurrency('kzt')">Продать</button></div></div>`; const w=document.getElementById('currency-wallets'); if(w){ w.innerHTML = `<div class="list-item"><div class="list-icon">💵</div><div class="list-info"><div class="list-name">USD</div></div><div class="list-price">${fmt(S.usd)} $</div></div><div class="list-item"><div class="list-icon">💶</div><div class="list-info"><div class="list-name">EUR</div></div><div class="list-price">${fmt(S.eur)} €</div></div><div class="list-item"><div class="list-icon">🇰🇿</div><div class="list-info"><div class="list-name">KZT</div></div><div class="list-price">${fmt(S.kzt)} ₸</div></div>`; } }
function buyCurrency(code){ const rate = S.rates[code]; if(!rate) return; const input = prompt('Сколько '+code.toUpperCase()+' купить?', '1'); if(input===null) return; const amt = parseFloat(input)||0; if(amt<=0){ toast('Введите сумму'); return; } const cost = Math.ceil(amt * rate * 1.02); if(S.balance<cost){ toast('Нужно '+fmt(cost)+' ₽'); return; } changeBalance(-cost); S[code] = (S[code]||0) + amt; addHistory('Куплено '+amt+' '+code.toUpperCase(), -cost); toast('Куплено'); renderCurrency(); save(); }
function sellCurrency(code){ const rate = S.rates[code]; if(!rate) return; const have = S[code]||0; if(have<=0){ toast('Нет '+code.toUpperCase()); return; } const input = prompt('Сколько продать? (есть '+have+')', String(have)); if(input===null) return; const amt = parseFloat(input)||0; if(amt<=0){ toast('Введите сумму'); return; } if(amt>have){ toast('Недостаточно'); return; } const income = Math.floor(amt * rate * 0.98); S[code] = have - amt; changeBalance(income); addHistory('Продано '+amt+' '+code.toUpperCase(), income); toast('Продано'); renderCurrency(); save(); }
function renderStyles(){ 
