function takeCredit(productId){ const p=CREDIT_PRODUCTS.find(x=>x.id===productId); if(!p) return; if(S.credits.some(c=>c.productId===p.id)){ toast('Уже активен'); return; } const earnings=getEarnings(); const max = Math.min(Math.floor(S.creditLimit*p.maxMul), earnings); if(max<=0){ toast('Лимит мал'); return; } const input = prompt(`Сумма (макс ${fmt(max)} ₽):`, Math.min(max,10000)); if(input===null) return; const amt=parseInt(input)||0; if(amt<=0){ toast('Введите сумму'); return; } if(amt>max){ toast('Выше лимита'); return; } const total = Math.floor(amt*(1+p.pct/100)); const due = Date.now() + p.hours*5*60*1000; S.credits.push({ productId:p.id, name:p.name, icon:p.icon, principal:amt, total, remaining:total, due }); changeBalance(amt); addHistory('Кредит: '+p.name, amt); toast('Одобрено: '+fmt(amt)+' ₽. К возврату: '+fmt(total)); updateUI(); renderCredit(); save(); }
function payCredit(index){ const c=S.credits[index]; if(!c) return; if(S.balance<c.remaining){ toast('Недостаточно средств'); return; } changeBalance(-c.remaining); addHistory('Погашен кредит: '+c.name, -c.remaining); S.credits.splice(index,1); if(S.credits.length===0) S.creditOverdue=false; toast('Кредит погашен'); updateUI(); renderCredit(); renderAll(); save(); }
function tickCredit(){ if(!S.credits.length) return; let overdue=false; S.credits.forEach(c=>{ if(Date.now()>=c.due){ overdue=true; const fee=Math.floor(c.remaining*0.1); if(S.balance>=fee){ changeBalance(-fee); c.remaining-=fee; } else { c.remaining += fee; } } }); S.creditOverdue = overdue; updateUI(); save(); if(overdue) renderAll(); }

