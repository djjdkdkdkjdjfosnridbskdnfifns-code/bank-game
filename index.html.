    if(phone.replace(/\D/g, '').length < 11){ toast('Введите номер полностью'); document.getElementById('reg-phone').classList.add('error-shake'); setTimeout(()=>document.getElementById('reg-phone').classList.remove('error-shake'), 400); return; }
    if(!agree){ toast('Подтвердите согласие'); return; }
    document.getElementById('reg-phone-display').textContent = phone;
    document.getElementById('reg-step1').classList.remove('active');
    document.getElementById('reg-step2').classList.add('active');
  } else if(step === 2){
    const code = document.getElementById('reg-code').value.trim();
