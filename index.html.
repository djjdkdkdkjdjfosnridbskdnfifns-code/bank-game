  const aEl = document.getElementById('avatars-list'); if(aEl){ aEl.innerHTML = AVATARS.map(a=>{ const owned=a.id==='default'||S.ownedAvatars.includes(a.id); const active=(S.activeAvatar||'default')===a.id; return `<div class="style-card ${active?'active':''}" onclick="selectAvatar('${a.id}')"><div class="sc-icon">${a.icon}</div><div class="sc-name">${a.name}</div><div class="sc-price">${owned?'✓':fmt(a.price)+' ₽'}</div></div>`; }).join(''); } 
