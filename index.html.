function selectFrame(id){ const f = FRAMES.find(x=>x.id===id); if(!f) return; if(!S.ownedFrames.includes(id)){ if(S.balance < f.price){ toast('Нужно '+fmt(f.price)+' ₽'); return; } S.balance -= f.price; S.ownedFrames.push(id); toast('Куплено: '+f.name); } S.activeFrame = (S.activeFrame===id) ? null : id; renderStyles(); renderProfile(); renderMiniAvatar(); save(); }
function selectAvatar(id){ const a = AVATARS.find(x=>x.id===id); if(!a) return; if(id!=='default' && !S.ownedAvatars.includes(id)){ if(S.balance < a.price){ toast('Нужно '+fmt(a.price)+' ₽'); return; } S.balance -= a.price; S.ownedAvatars.push(id); toast('Куплено: '+a.name); } S.activeAvatar = id; renderStyles(); renderProfile(); renderMiniAvatar(); save(); }
function selectBg(id){ const b = BACKGROUNDS.find(x=>x.id===id); if(!b) return; if(!S.ownedBgs.includes(id)){ if(S.balance < b.price){ toast('Нужно '+fmt(b.price)+' ₽'); return; } S.balance -= b.price; S.ownedBgs.push(id); toast('Куплено: '+b.name); } S.activeBg = (S.activeBg===id) ? null : id; renderStyles(); renderProfile(); save(); }
function selectFx(id){ const e = EFFECTS.find(x=>x.id===id); if(!e) return; if(!S.ownedFx.includes(id)){ if(S.balance < e.price){ toast('Нужно '+fmt(e.price)+' ₽'); return; } S.balance -= e.price; S.ownedFx.push(id); toast('Куплено: '+e.name); } S.activeFx = (S.activeFx===id) ? null : id; renderStyles(); renderProfile(); save(); }
function selectNickColor(id){ const c = NICK_COLORS.find(x=>x.id===id); if(!c) return; if(!S.ownedNickColors.includes(id)){ if(S.balance < c.price){ toast('Нужно '+fmt(c.price)+' ₽'); return; } S.balance -= c.price; S.ownedNickColors.push(id); toast('Куплено: '+c.name); } S.nickColor = id; renderStyles(); renderProfile(); save(); }
function selectNickFont(id){ const f = NICK_FONTS.find(x=>x.id===id); if(!f) return; if(id!=='normal' && !S.ownedNickFonts.includes(id)){ if(S.balance < f.price){ toast('Нужно '+fmt(f.price)+' ₽'); return; } S.balance -= f.price; S.ownedNickFonts.push(id); toast('Куплено: '+f.name); } S.nickFont = id; renderStyles(); renderProfile(); save(); }
function renderMiniAvatar(){ const el = document.getElementById('user-icon-mini'); if(!el) return; const a = AVATARS.find(x=>x.id===(S.activeAvatar||'default')); el.textContent = a ? a.icon : '👤'; }

function renderCases(){ const el=document.getElementById('cases-list'); if(!el) return; el.innerHTML=CASES.map(c=>`<div class="list-item"><div class="list-icon">${c.icon}</div><div class="list-info"><div class="list-name">${c.name}</div></div><button style="width:auto;padding:0 16px;height:38px;font-size:13px" onclick="openCase(${c.price})">${fmt(c.price)} ₽</button></div>`).join(''); }
function rollItem(){ const r=Math.random()*100; let acc=0, rarity='common'; for(const k in RARITY){ acc+=RARITY[k].chance; if(r<=acc){ rarity=k; break; } } const pool=ITEMS.filter(i=>i.rarity===rarity); return pool[Math.floor(Math.random()*pool.length)]; }
function openCase(price){ if(S.balance<price){ toast('Недостаточно средств'); return; } changeBalance(-price); const it=rollItem(); S.collection.push(it.id); const r=RARITY[it.rarity]; toast(`Выпал ${it.icon} ${it.name} (${r.name}, ${fmt(it.price)} ₽)`); addXP(15); if(it.rarity==='legendary') confetti(); renderCollection(); save(); }
function renderCollection(){ const el=document.getElementById('collection-list'); if(!el) return; if(!S.collection.length){ el.innerHTML='<div style="text-align:center;color:#8a929b;padding:20px">Пока пусто.</div>'; return; } const counts={}; S.collection.forEach(id=>counts[id]=(counts[id]||0)+1); let totalValue=0; const rows=Object.keys(counts).map(id=>{ const it=ITEMS.find(x=>x.id===id); if(!it) return ''; const r=RARITY[it.rarity]; totalValue += it.price*counts[id]; return `<div class="list-item"><div class="list-icon" style="background:${r.color}20">${it.icon}</div><div class="list-info"><div class="list-name">${it.name} <span style="font-size:10px;color:${r.color}">${r.name}</span></div><div class="list-desc">${fmt(it.price)} ₽ · ×${counts[id]}</div></div><button style="width:auto;padding:0 12px;height:34px;font-size:11px;background:#00c853;color:#fff" onclick="sellItem('${id}')">Продать</button></div>`; }).join(''); el.innerHTML=`<div style="background:rgba(0,0,0,0.05);padding:12px;border-radius:12px;margin-bottom:12px;text-align:center"><div style="font-size:11px;color:#8a929b">Стоимость коллекции</div><div style="font-size:20px;font-weight:900">${fmt(totalValue)} ₽</div></div>`+rows; }
function sellItem(id){ const idx=S.collection.indexOf(id); if(idx<0){ toast('Нет такого предмета'); return; } const it=ITEMS.find(x=>x.id===id); if(!it) return; S.collection.splice(idx,1); changeBalance(it.price); addHistory('Продан предмет: '+it.name, it.price); toast('Продан '+it.icon+' '+it.name); renderCollection(); save(); }

function robBank(){ const log=document.getElementById('rob-log'); if(S.balance<10000){ log.textContent='Нужно 10 000 ₽ залога'; log.style.color='#ff3b30'; return; } if(Date.now()<(S.jobBlockUntil||0)){ log.textContent='Ты в розыске, подожди'; log.style.color='#ff3b30'; return; } changeBalance(-10000); if(Math.random()<0.15){ const win=Math.floor(50000+Math.random()*150000); changeBalance(win); confetti(); S.reputation+=5; addXP(30); log.textContent='УСПЕХ! +'+fmt(win)+' ₽'; log.style.color='#00c853'; addHistory('Ограбление банка', win); } else { const fine=Math.floor(10000+Math.random()*20000); changeBalance(-fine); S.reputation=Math.max(0,(S.reputation||0)-5); S.jobBlockUntil=Date.now()+5*60*1000; log.textContent='Провал! Штраф '+fmt(fine)+' ₽ и блок работ'; log.style.color='#ff3b30'; addHistory('Провал ограбления', -fine); } save(); updateUI(); }
function shellGame(choice){ const log=document.getElementById('shell-log'); if(S.balance<1000){ log.textContent='Нужно 1000 ₽'; log.style.color='#ff3b30'; return; } changeBalance(-1000); const correct=Math.floor(Math.random()*3); if(choice===correct){ changeBalance(3000); confetti(); log.textContent='🎉 Угадал! +3000 ₽'; log.style.color='#00c853'; } else { log.textContent='😢 Шарик был под №'+(correct+1); log.style.color='#ff3b30'; } save(); updateUI(); }
function renderWheel(){ const el=document.getElementById('wheel-list'); if(!el) return; el.innerHTML=`<button onclick="spinWheel()" style="background:#a855f7;color:#fff">🎡 Крутить (500 ₽)</button>`; }
function spinWheel(){ if(S.balance<500){ toast('Нужно 500 ₽'); return; } changeBalance(-500); const win=[0,500,1000,2000][Math.floor(Math.random()*4)]; if(win){ changeBalance(win); confetti(); toast('+'+fmt(win)+' ₽'); } else toast('Пусто'); }
function freeWheel(){ const now = Date.now(); if(now - (S.lastFreeWheel||0) < 24*60*60*1000){ toast('Бесплатное колесо уже крутили сегодня'); return; } S.lastFreeWheel = now; const prizes = [100, 500, 1000, 5000, 10000]; const win = prizes[Math.floor(Math.random()*prizes.length)]; changeBalance(win); confetti(); toast('🎡 Бесплатное колесо: +'+fmt(win)+' ₽'); save(); }

function renderShop(){ 
  const el=document.getElementById('shop-list'); if(!el) return; 
  const pb = premiumBonus(); 
  el.innerHTML=SHOP.map(s=>{ 
    const price = Math.floor(s.price * (1 - pb.discount/100)); 
    const priceHtml = price < s.price ? `<span style="text-decoration:line-through;color:#8a929b;font-size:11px;margin-right:5px">${fmt(s.price)} ₽</span>${fmt(price)} ₽` : `${fmt(price)} ₽`; 
    return `<div class="list-item"><div class="list-icon">${s.icon}</div><div class="list-info"><div class="list-name">${s.name}</div><div class="list-desc">${priceHtml}</div></div><button style="width:auto;padding:0 16px;height:38px;font-size:13px;margin:0" ${S.creditOverdue?'disabled':''} onclick="buyShop('${s.id}',${price})">Купить</button></div>`; 
  }).join(''); 
  el.innerHTML += `<div class="block-title" style="margin-top:20px">🎨 Темы интерфейса</div>`; 
  el.innerHTML += THEMES.map(t=>{ 
    const owned = S.ownedThemes.includes(t.id); 
    const active = S.activeTheme === t.id; 
    return `<div class="list-item"><div class="list-icon">${t.icon}</div><div class="list-info"><div class="list-name">${t.name} ${active?'(Активна)':''}</div><div class="list-desc">${owned ? (active ? 'Установлена' : 'Куплена') : fmt(t.price)+' ₽'}</div></div><button style="width:auto;padding:0 14px;height:34px;font-size:11px;margin:0;background:${active?'#00c853':'var(--accent)'};color:${active?'#fff':'var(--text-btn)'}" onclick="buyTheme('${t.id}')">${owned ? (active ? 'Вкл.' : 'Включить') : 'Купить'}</button></div>`; 
  }).join(''); 
}
function buyShop(id, price){ if(S.creditOverdue){ toast('Магазин недоступен: просрочка кредита'); return; } if(S.balance<price){ toast('Недостаточно средств'); return; } const item = SHOP.find(x=>x.id===id); changeBalance(-price); if(item && item.type==='energy'){ S.energy = Math.min(200, (S.energy||100)+item.value); toast('+'+item.value+' энергии'); } else if(id==='frame'){ if(!S.ownedFrames.includes('gold')) S.ownedFrames.push('gold'); S.activeFrame='gold'; toast('Золотая рамка активирована'); } else if(id==='nick'){ const newNick = prompt('Введите новый ник (минимум 5 букв):'); if(newNick && lettersCount(newNick) >= 5){ S.name = newNick.toUpperCase(); toast('Ник изменён на ' + S.name); } else if(newNick) { toast('Ник должен быть не короче 5 букв'); } } else { toast('Куплено: '+(item?item.name:id)); } addXP(5); renderProfile(); save(); }
function buyTheme(id){ const t = THEMES.find(x=>x.id===id); if(!t) return; if(!S.ownedThemes.includes(id)){ if(S.balance < t.price){ toast('Недостаточно средств ('+fmt(t.price)+' ₽)'); return; } changeBalance(-t.price); S.ownedThemes.push(id); toast('Куплена тема: '+t.name); } applyTheme(id); renderShop(); renderProfile(); }

function sendSMS(text) {
  const time = new Date().toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'});
  S.smsHistory.unshift({ text: text, time: time });
  if(S.smsHistory.length > 20) S.smsHistory.pop();
  updateSMSBadge(); save();
}
function renderSMS() {
  const el = document.getElementById('sms-list'); if(!el) return;
  if(!S.smsHistory.length) { el.innerHTML = '<div style="text-align:center;color:#8a929b;padding:20px">Нет сообщений</div>'; return; }
  el.innerHTML = S.smsHistory.map(m => `<div style="background:rgba(0,0,0,0.05);padding:10px;border-radius:10px;margin-bottom:8px"><div style="font-weight:800;color:#007aff;margin-bottom:3px">БелКристаллБанк</div><div>${m.text}</div><div style="font-size:10px;color:#8a929b;text-align:right;margin-top:5px">${m.time}</div></div>`).join('');
}
function openSMS() {
  renderSMS();
  const badge = document.getElementById('sms-badge');
  if(badge) badge.style.display = 'none';
  document.getElementById('sms-modal').classList.add('active');
}
function updateSMSBadge() {
  const badge = document.getElementById('sms-badge');
  if(badge) { badge.style.display = 'block'; badge.textContent = S.smsHistory.length > 9 ? '9+' : S.smsHistory.length; }
}function tickContracts() {
  if(!S.contracts.length) return;
  const now = Date.now(); let changed = false;
  S.contracts = S.contracts.filter(c => {
    if(now > c.due) {
      if(!S.violations) S.violations = [];
      S.violations.push({ debtor: c.debtor, amount: c.amount, fine: Math.floor(c.amount * 1.5), date: new Date().toLocaleString('ru-RU') });
      sendSMS(`⚖️ Нотариус: Игрок ${c.debtor} просрочил долг ${fmt(c.amount)} ₽. Вы можете подать на него в СУД!`);
      toast(`Должник ${c.debtor} кинул вас! Подайте в суд.`);
      changed = true; return false;
    }
    return true;
  });
  if(changed) { renderAll(); save(); }
}

function renderCourt() {
  const el = document.getElementById('court-list'); if(!el) return;
  if(!S.violations || !S.violations.length) { el.innerHTML = '<div style="text-align:center;color:#8a929b;padding:20px">У вас нет активных исков.</div>'; return; }
  el.innerHTML = S.violations.map((v, i) => `<div class="list-item"><div class="list-icon">⚖️</div><div class="list-info"><div class="list-name">Иск к: ${v.debtor}</div><div class="list-desc">Долг: ${fmt(v.amount)} ₽ · Штраф: ${fmt(v.fine)} ₽</div></div><button style="width:auto;padding:0 12px;height:34px;font-size:11px;background:#ff3b30;color:#fff" onclick="fileLawsuit(${i})">В суд</button></div>`).join('');
}
function fileLawsuit(index) {
  if(!S.violations || !S.violations[index]) return;
  const v = S.violations[index];
  if(!confirm(`Подать в суд на ${v.debtor}? С него взыщут ${fmt(v.fine)} ₽.`)) return;
  toast('Суд рассматривает дело...');
  setTimeout(() => {
    changeBalance(v.fine);
    addHistory('Выигран суд против ' + v.debtor, v.fine);
    S.violations.splice(index, 1);
    toast(`⚖️ Суд выигран! Взыскано ${fmt(v.fine)} ₽.`);
    sendSMS(`⚖️ Суд: Вы выиграли дело против ${v.debtor}. Взыскано ${fmt(v.fine)} ₽.`);
    confetti(); renderCourt(); renderProfile(); save();
  }, 2000);
}

function switchTransferType(type){ S.transferType=type; ['transfer','loan','property'].forEach(t=>{ const b=document.getElementById('btn-type-'+t); if(b){ b.style.background=(t===type)?'#000':'var(--bg)'; b.style.color=(t===type)?'#fff':'var(--text)'; } }); document.getElementById('money-block').style.display=(type==='property')?'none':'block'; document.getElementById('property-block').style.display=(type==='property')?'block':'none'; checkNotaryNeeded(); }
function checkNotaryNeeded(){ const amt=parseInt(document.getElementById('transfer-amount').value)||0; const block=document.getElementById('notary-block'); let need=false; if(S.transferType==='loan' && amt>50000) need=true; if(S.transferType==='property') need=true; block.style.display=need?'block':'none'; S.notaryOk=!need; }
function checkNotaryReady(){ const a1=document.getElementById('notary-agree1').checked; const a2=document.getElementById('notary-agree2').checked; S.notaryOk=a1&&a2; }
function doTransfer(){
  const name=document.getElementById('transfer-name').value.trim(); const log=document.getElementById('transfer-log');
  if(!name){ log.textContent='Введите ник'; return; }
  
  if(S.transferType==='property'){ 
    const sel=document.getElementById('transfer-property'); const val=sel.value; 
    if(!val){ log.textContent='Выберите имущество'; return; } 
    if(!S.notaryOk){ log.textContent='Нужен нотариус'; return; } 
    const [kind, idxStr]=val.split(':'); let itemName=''; 
    if(kind==='car'){ const idx=parseInt(idxStr); if(!S.ownedCars.includes(idx)){ log.textContent='Нет такого авто'; return; } S.ownedCars=S.ownedCars.filter(x=>x!==idx); itemName=CARS[idx].name; } 
    else if(kind==='house'){ const idx=parseInt(idxStr); if(!S.ownedHouses.includes(idx)){ log.textContent='Нет такого дома'; return; } S.ownedHouses=S.ownedHouses.filter(x=>x!==idx); itemName=HOUSES[idx].name; } 
    else if(kind==='business'){ if(!S.ownedBusiness.includes(idxStr)){ log.textContent='Нет такого бизнеса'; return; } const b=BUSINESS.find(x=>x.id===idxStr); itemName=b?b.name:'Бизнес'; S.ownedBusiness=S.ownedBusiness.filter(x=>x!==idxStr); } 
    addHistory('Передано: '+itemName+' → '+name, 0); 
    log.textContent='Нотариус заверил: '+itemName+' → '+name; log.style.color='#00c853'; 
    renderAll(); save(); return; 
  }
  
  const amt=parseInt(document.getElementById('transfer-amount').value)||0;
  if(amt<=0){ log.textContent='Введите сумму'; return; }
  if(S.balance<amt){ log.textContent='Недостаточно средств'; return; }
  
  if(S.transferType==='loan' && amt>50000){ 
    if(!S.notaryOk){ log.textContent='Поставьте галочки нотариуса!'; return; } 
    changeBalance(-amt); 
    const contract = { id: Date.now(), debtor: name, amount: amt, returnAmount: Math.floor(amt * 1.1), due: Date.now() + (10 * 60 * 1000) }; 
    S.contracts.push(contract); 
    log.textContent = `✅ Договор с ${name} заключен! Сумма: ${fmt(amt)} ₽. Деньги заморожены у нотариуса.`; 
    log.style.color = '#00c853'; 
    sendSMS(`⚖️ Нотариус: Игрок ${S.name} дал вам в долг ${fmt(amt)} ₽. Вернуть до: ${new Date(contract.due).toLocaleTimeString()}. Сумма к возврату: ${fmt(contract.returnAmount)} ₽.`); 
    renderAll(); save(); return; 
  }
  
  changeBalance(-amt); 
  addHistory('Перевод '+name, -amt); 
  log.textContent = 'Переведено: '+fmt(amt)+' ₽ → '+name; 
  log.style.color = '#00c853'; 
  document.getElementById('transfer-name').value=''; 
  document.getElementById('transfer-amount').value=''; 
  renderAll();
}

function playCasino(){ 
  const bet=parseInt(document.getElementById('casino-bet').value)||0; 
  const log=document.getElementById('casino-log'); 
  if(bet<100){ log.textContent='Мин. ставка 100 ₽'; log.style.color='#ff3b30'; return; } 
  if(S.balance<bet){ log.textContent='Недостаточно средств'; log.style.color='#ff3b30'; return; } 
  changeBalance(-bet); 
  const win = bet*20; 
  changeBalance(win); 
  confetti(); 
  log.textContent='🎉 Выигрыш: '+fmt(win)+' ₽ (x20)'; 
  log.style.color='#00c853'; 
  addXP(5); 
  renderAll(); 
}function renderPremium(){ 
  const el=document.getElementById('premium-list'); if(!el) return; 
  const now=Date.now(); 
  const activeLevel = (S.premiumLevel && now<S.premiumUntil) ? S.premiumLevel : 0; 
  el.innerHTML = PREMIUM_LEVELS.map(p=>{ 
    const isActive = activeLevel===p.level; 
    const p7=p.price7, p14=Math.floor(p7*1.8), p30=Math.floor(p7*3.5); 
    return `<div class="prem-card ${isActive?'active':''}"><div class="prem-title">${p.name} ${isActive?'(активен)':''}</div><div class="prem-desc">+${p.salaryBonus}% к ЗП · +${p.energyBonus} энергии · скидка ${p.discount}% · бонус ×${p.dailyMul}</div><div style="display:flex;gap:5px;margin-top:10px"><button style="flex:1;height:36px;font-size:11px;background:${isActive?'#f59e0b':'var(--accent)'};color:${isActive?'#fff':'var(--text-btn)'}" onclick="buyPremium(${p.level}, 7, ${p7})">7 дн.<br>${fmt(p7)} ₽</button><button style="flex:1;height:36px;font-size:11px;background:${isActive?'#f59e0b':'var(--accent)'};color:${isActive?'#fff':'var(--text-btn)'}" onclick="buyPremium(${p.level}, 14, ${p14})">14 дн.<br>${fmt(p14)} ₽</button><button style="flex:1;height:36px;font-size:11px;background:${isActive?'#f59e0b':'var(--accent)'};color:${isActive?'#fff':'var(--text-btn)'}" onclick="buyPremium(${p.level}, 30, ${p30})">30 дн.<br>${fmt(p30)} ₽</button></div></div>`; 
  }).join(''); 
  if(activeLevel){ 
    const msLeft = S.premiumUntil - now; 
    const daysLeft = Math.floor(msLeft / (24*60*60*1000)); 
    const hoursLeft = Math.floor((msLeft % (24*60*60*1000)) / (60*60*1000)); 
    el.innerHTML += `<div style="text-align:center;font-size:12px;color:#8a929b;margin-top:8px">Осталось: <b>${daysLeft} дн. ${hoursLeft} ч.</b></div>`; 
  } 
}
function buyPremium(level, days, price){ 
  if(S.balance < price){ toast('Нужно '+fmt(price)+' ₽'); return; } 
  changeBalance(-price); 
  const msInDay = 24 * 60 * 60 * 1000; 
  if(S.premiumLevel === level && Date.now() < S.premiumUntil) { S.premiumUntil += days * msInDay; } 
  else { S.premiumLevel = level; S.premiumUntil = Date.now() + (days * msInDay); } 
  toast('Премиум: куплено на '+days+' дней'); 
  renderPremium(); renderProfile(); save(); 
}

function renderLevel(){ 
  const el=document.getElementById('level-box'); if(!el) return; 
  const need=xpForLevel(S.level); 
  el.innerHTML = `<div style="text-align:center;font-size:20px;font-weight:900;margin-bottom:8px">Уровень ${S.level}</div><div style="text-align:center;font-size:12px;color:#8a929b;margin-bottom:8px">${Math.floor(S.xpAccum)} / ${need} XP до следующего</div><div class="lvl-bar"><div class="lvl-fill" style="width:${Math.min(100,Math.floor((S.xpAccum/need)*100))}%"></div></div><div style="text-align:center;font-size:12px;color:#8a929b;margin-top:8px">Всего XP: ${fmt(S.xp)} · Макс. уровень: 500</div><div style="font-size:12px;color:#8a929b;margin-top:8px">50 XP за каждый час в игре.</div>`; 
}

function renderProfile(){
  const nameEl = document.getElementById('profile-name-display'); nameEl.textContent=S.name; nameEl.className = '';
  const nc = NICK_COLORS.find(x=>x.id===S.nickColor); if(nc){ if(nc.css) nameEl.classList.add(nc.css); else if(nc.hex) nameEl.style.color = nc.hex; } else nameEl.style.color='';
  const nf = NICK_FONTS.find(x=>x.id===S.nickFont); if(nf && nf.css) nameEl.classList.add(nf.css);
  document.getElementById('profile-balance').textContent=fmt(S.balance);
  document.getElementById('profile-tasks').textContent=S.tasksDone;
  const rep=document.getElementById('profile-status-display'); const pb = premiumBonus();
  if(rep) rep.textContent=(S.creditOverdue?'Должник':'Новичок')+' · Реп: '+(S.reputation||0)+(pb.badge?' · '+pb.badge:'');
  const wealthEl = document.getElementById('profile-wealth'); if(wealthEl) wealthEl.textContent = '💰 Состояние: '+fmt(getWealth())+' ₽';
  const lvlEl = document.getElementById('profile-level'); if(lvlEl){ const need=xpForLevel(S.level); lvlEl.textContent='Ур. '+S.level+' · '+Math.floor(S.xpAccum)+'/'+need+' XP'; }
  const fill = document.getElementById('profile-lvl-fill'); if(fill){ const need=xpForLevel(S.level); fill.style.width = Math.min(100, Math.floor((S.xpAccum/need)*100))+'%'; }
  const core = document.getElementById('profile-ava-core'); if(core){ const a = AVATARS.find(x=>x.id===(S.activeAvatar||'default')); core.textContent = a ? a.icon : '👤'; }
  const ring = document.getElementById('profile-frame-ring'); if(ring){ ring.className = 'frame-ring'; if(S.activeFrame){ const f = FRAMES.find(x=>x.id===S.activeFrame); if(f) ring.classList.add(f.css); } }
  const bgRing = document.getElementById('profile-bg-ring'); if(bgRing){ bgRing.className = 'bg-ring'; if(S.activeBg){ const b = BACKGROUNDS.find(x=>x.id===S.activeBg); if(b) bgRing.classList.add(b.css); } }
  const fxLayer = document.getElementById('profile-fx-layer'); if(fxLayer){ fxLayer.className = 'fx-layer'; if(S.activeFx){ const e = EFFECTS.find(x=>x.id===S.activeFx); if(e) fxLayer.classList.add(e.css); } }
  const pc = document.getElementById('profile-contracts'); if(pc) { if(!S.contracts.length) pc.innerHTML = 'Нет активных сделок'; else { pc.innerHTML = S.contracts.map(c => { const left = Math.ceil((c.due - Date.now()) / 60000); return `<div style="padding:4px 0;border-bottom:1px solid rgba(0,0,0,0.1)"><b>${c.debtor}</b> — ${fmt(c.amount)} ₽<br><span style="color:#f59e0b">Осталось: ${left} мин. К возврату: ${fmt(c.returnAmount)} ₽</span></div>`; }).join(''); } }
  const pHouses = document.getElementById('profile-houses'); if(pHouses){ if(!S.ownedHouses.length) pHouses.innerHTML='<span style="color:#8a929b">Пока ничего не куплено</span>'; else pHouses.innerHTML = S.ownedHouses.map(i=>{ const h=HOUSES[i]; return h?`<div style="padding:4px 0">${h.icon} ${h.name} — ${fmt(h.price)} ₽</div>`:''; }).join(''); }
  const pCars = document.getElementById('profile-cars'); if(pCars){ if(!S.ownedCars.length) pCars.innerHTML='<span style="color:#8a929b">Пока ничего не куплено</span>'; else pCars.innerHTML = S.ownedCars.map(i=>{ const c=CARS[i]; return c?`<div style="padding:4px 0">${c.icon} ${c.name} — ${fmt(c.price)} ₽</div>`:''; }).join(''); }
  const pBus = document.getElementById('profile-business'); if(pBus){ if(!S.ownedBusiness.length) pBus.innerHTML='<span style="color:#8a929b">Пока ничего не куплено</span>'; else pBus.innerHTML = S.ownedBusiness.map(id=>{ const b=BUSINESS.find(x=>x.id===id); return b?`<div style="padding:4px 0">${b.icon} ${b.name} — ${fmt(b.price)} ₽</div>`:''; }).join(''); }
  renderMiniAvatar();
}
function renderPropertyOptions(){ const sel=document.getElementById('transfer-property'); if(!sel) return; let html='<option value="">— выбери —</option>'; S.ownedCars.forEach(i=>{ if(CARS[i]) html+=`<option value="car:${i}">🚗 ${CARS[i].name}</option>`; }); S.ownedHouses.forEach(i=>{ if(HOUSES[i]) html+=`<option value="house:${i}">🏠 ${HOUSES[i].name}</option>`; }); S.ownedBusiness.forEach(id=>{ const b=BUSINESS.find(x=>x.id===id); if(b) html+=`<option value="business:${id}">💼 ${b.name}</option>`; }); sel.innerHTML=html; }
function renderTasks(){ const el=document.getElementById('tasks-list'); if(!el) return; el.innerHTML=TASKS.map(t=>{ const done=tasksState[t.id]; return `<div class="list-item"><div class="list-icon">🎯</div><div class="list-info"><div class="list-name">${t.name}</div><div class="list-desc">+${fmt(t.reward)} ₽</div></div>${done?'<span style="color:#00c853;font-weight:800">✓</span>':`<button style="width:auto;padding:0 16px;height:38px;font-size:13px" ${S.creditOverdue?'disabled':''} onclick="claimTask('${t.id}',${t.reward})">Забрать</button>`}</div>`; }).join(''); }
function claimTask(id, reward){ if(S.creditOverdue){ toast('Кредит просрочен'); return; } tasksState[id]=true; S.tasksDone++; changeBalance(reward); confetti(); renderTasks(); renderProfile(); }

function renderForbes(){ const el=document.getElementById('forbes-list'); if(!el) return; const list=[...FORBES]; list[2].money=getWealth(); list.sort((a,b)=>b.money-a.money); el.innerHTML=list.map((f,i)=>`<div class="list-item"><div class="list-icon">${i+1}</div><div class="list-info"><div class="list-name">${f.name}</div></div><div class="list-price">${fmt(f.money)} ₽</div></div>`).join(''); }
function renderHistory(){ const el=document.getElementById('history-list'); if(!el) return; if(!S.history.length){ el.innerHTML='<div style="text-align:center;color:#8a929b;padding:20px">Пока пусто</div>'; return; } el.innerHTML=S.history.map(h=>`<div class="list-item"><div class="list-info"><div class="list-name">${h.text}</div><div class="list-desc">${h.time}</div></div><div class="list-price" style="color:${h.amount>=0?'#00c853':'#ff3b30'}">${h.amount>=0?'+':''}${fmt(h.amount)} ₽</div></div>`).join(''); }

function renderAll(){ 
  renderTasks(); renderWork(); renderDocs(); renderWorkBook(); renderCars(); renderHouses(); 
  renderBusiness(); renderCredit(); renderCollection(); renderSocial(); renderCurrency(); 
  renderStyles(); renderMiniAvatar(); renderPremium(); renderLevel(); renderCourt(); 
  renderCases(); renderWheel(); renderShop(); renderForbes(); renderHistory(); 
  renderPropertyOptions(); renderProfile(); updateUI(); 
}function addXP(xp){ if(S.level>=500) return; S.xp += xp; S.xpAccum += xp; while(S.level<500 && S.xpAccum>=xpForLevel(S.level)){ S.xpAccum -= xpForLevel(S.level); S.level++; rewardLevel(S.level); } save(); }
function rewardLevel(lvl){ 
  const r = LEVEL_REWARDS[lvl]; if(!r) return; 
  let txt='🎉 Уровень '+lvl+'! '; 
  if(r.money){ changeBalance(r.money); txt+='+'+fmt(r.money)+' ₽ '; } 
  if(r.usd){ S.usd+=r.usd; txt+='+'+fmt(r.usd)+' $ '; } 
  if(r.energy){ S.energy=Math.min(200,(S.energy||100)+r.energy); txt+='+'+r.energy+' энергии '; } 
  if(r.salaryBonus){ S.salaryBoost=(S.salaryBoost||0)+r.salaryBonus; txt+='+'+r.salaryBonus+'% к ЗП '; } 
  if(r.frame){ if(!S.ownedFrames.includes(r.frame)) S.ownedFrames.push(r.frame); txt+='+рамка '; } 
  if(r.badge){ txt+='+значок '+r.badge+' '; } 
  toast(txt); confetti(); 
}
function tickXP(){ 
  const now = Date.now(); 
  if(!S.lastXpTick){ S.lastXpTick=now; return; } 
  const dtSec = (now-S.lastXpTick)/1000; 
  S.lastXpTick = now; 
  if(!document.hidden){ 
    const xpPerSec = 50/3600; 
    S.xpAccumBuffer = (S.xpAccumBuffer||0) + dtSec*xpPerSec; 
    while(S.xpAccumBuffer >= 1){ S.xpAccumBuffer -= 1; addXP(1); } 
  } 
  save(); 
}
function checkDailyBonus(){ 
  const now = Date.now(); 
  if(now - (S.lastDaily||0) < 24*60*60*1000) return; 
  S.dailyStreak = (S.dailyStreak||0) + 1; 
  S.lastDaily = now; 
  const pb = premiumBonus(); 
  const bonus = Math.min(20000, 1000 * S.dailyStreak * pb.daily); 
  changeBalance(bonus); 
  toast('🎁 Бонус: +'+fmt(bonus)+' ₽ (серия '+S.dailyStreak+')'); 
  save(); 
}
function randomEvent(){ 
  if(Math.random() > 0.6) return; 
  const events = [ 
    { text:'Нашёл кошелёк', amount:5000 }, 
    { text:'Штраф за парковку', amount:-2000 }, 
    { text:'Подарок от друга', amount:10000 }, 
    { text:'Ремонт телефона', amount:-5000 }, 
    { text:'Выиграл в лотерею', amount:25000 }, 
    { text:'Налоговая вернула', amount:3000 } 
  ]; 
  const e = events[Math.floor(Math.random()*events.length)]; 
  changeBalance(e.amount); 
  toast(e.text+': '+(e.amount>=0?'+':'')+fmt(e.amount)+' ₽'); 
}
function tickRates(){ 
  ['usd','eur','kzt'].forEach(k=>{ 
    const base = { usd:90, eur:100, kzt:0.20 }[k]; 
    const change = 1 + (Math.random()-0.5)*0.06; 
    S.rates[k] = Math.max(0.01, +(base*change).toFixed(2)); 
  }); 
  renderCurrency(); save(); 
}
function tickEnergy(){ 
  const pb = premiumBonus(); 
  S.energy = Math.min(100, (S.energy||100)+2+pb.energy); 
  save(); 
}
function tickPresident(){ 
  if(S.presidentWaitUntil > 0 && Date.now() > S.presidentWaitUntil) { 
    const req = PRESIDENT_STAGES.find(s=>s.stage===S.presidentStage); 
    if(req && !S.presidentApproved) { 
      if(Math.random() < req.chance) { S.presidentApproved = true; toast('🎉 Заявка одобрена! ' + req.name); confetti(); } 
      else { toast('❌ Заявка отклонена. Попробуйте снова.'); S.presidentStage = Math.max(0, S.presidentStage - 1); } 
      S.presidentWaitUntil = 0; 
      renderAll(); save(); 
    } 
  } 
}

document.addEventListener('click', function(e){ 
  if((e.target.tagName === 'BUTTON' || e.target.closest('.menu-item') || e.target.closest('.style-card')) && navigator.vibrate) { navigator.vibrate(20); } 
});function lettersCount(str){ return (str.match(/[a-zA-Zа-яА-ЯёЁ]/g)||[]).length; }

load();
calcLimit();

if(S.balance < 50000 && S.name === 'PRESIDENT') S.balance = 50000;
applyTheme(S.activeTheme || 'light');

if(S.name && S.name !== 'PRESIDENT'){ 
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active')); 
  document.getElementById('app-screen').style.display='block'; 
  renderAll(); 
  updateUI(); 
}

renderMiniAvatar(); 
updateSMSBadge();

setInterval(()=>{ 
  try{ 
    tickCredit(); 
    if(S.job && Date.now()>=S.jobEnd) completeJob(); 
    tickXP(); 
    tickContracts(); 
    tickPresident(); 
    updateUI(); 
  }catch(e){ console.warn(e); } 
}, 1000);

setInterval(payBusinessIncome, 5*60*1000);
setInterval(randomEvent, 4*60*1000);
setInterval(tickRates, 30000);
setInterval(tickEnergy, 60000);

setTimeout(checkDailyBonus, 1500);
</script>
