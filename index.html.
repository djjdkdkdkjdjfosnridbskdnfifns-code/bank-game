<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>БелКристаллБанк</title>
<style>
:root{--bg:#f8f9fa;--text:#1a1a1a;--card:#fff;--border:#f0f2f5;--accent:#FFDD2D;--text-btn:#000;--nav-bg:#fff}
body.dark-theme{--bg:#121212;--text:#fff;--card:#1e1e1e;--border:#333;--accent:#FFDD2D;--text-btn:#000;--nav-bg:#1e1e1e}
body.theme-red{--bg:#1a0000;--text:#fff;--card:#2a0000;--border:#550000;--accent:#ff3b30;--text-btn:#fff;--nav-bg:#1a0000}
body.theme-green{--bg:#001a00;--text:#0f0;--card:#002200;--border:#005500;--accent:#00ff00;--text-btn:#000;--nav-bg:#001a00}
body.theme-blue{--bg:#001a33;--text:#fff;--card:#002b4d;--border:#004080;--accent:#00bfff;--text-btn:#000;--nav-bg:#001a33}
body.theme-purple{--bg:#1a0033;--text:#fff;--card:#2a0055;--border:#5500aa;--accent:#a855f7;--text-btn:#fff;--nav-bg:#1a0033}
body.theme-gold{--bg:#1a1500;--text:#fff;--card:#2a2200;--border:#554400;--accent:#FFD700;--text-btn:#000;--nav-bg:#1a1500}

*{box-sizing:border-box;margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;-webkit-tap-highlight-color:transparent;user-select:none}
body{background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden;padding-bottom:85px;transition:background .3s,color .3s}
.demo-banner{background:rgba(0,0,0,0.05);color:#8a929b;font-size:10px;font-weight:600;text-align:center;padding:8px 10px;position:sticky;top:0;z-index:9999;border-bottom:1px solid var(--border)}
.screen{display:none;min-height:100vh;padding:20px;flex-direction:column;align-items:center;justify-content:center;background:var(--bg)}
.screen.active{display:flex}
.reg-box{background:var(--card);border-radius:24px;padding:30px 20px;width:100%;max-width:400px;text-align:center;border:1px solid var(--border)}
.reg-title{font-size:24px;font-weight:800;color:var(--text);margin-bottom:8px}
.reg-hint{background:rgba(0,0,0,0.05);border-radius:12px;padding:12px;font-size:12px;color:#8a929b;margin-bottom:24px;line-height:1.5}
.reg-input{width:100%;height:54px;background:var(--bg);border:1.5px solid var(--border);border-radius:14px;color:var(--text);font-size:16px;font-weight:600;padding:0 16px;outline:none;margin-bottom:12px;text-align:center;transition:all .2s}
.reg-input:focus{border-color:var(--accent);box-shadow:0 4px 12px rgba(255,221,45,0.15)}
.reg-btn{background:var(--accent);color:var(--text-btn);border:none;height:54px;font-size:16px;font-weight:700;border-radius:14px;cursor:pointer;width:100%;transition:all .15s;margin-top:10px}
.reg-btn:active{transform:scale(0.98);opacity:0.9}
.header{background:var(--bg);padding:20px 20px 0}
.header-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.logo{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:800;color:var(--text)}
.logo-icon{background:var(--accent);color:var(--text-btn);width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900}
.user-icon{width:38px;height:38px;background:var(--card);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;cursor:pointer;border:1px solid var(--border);position:relative}
.card{background:linear-gradient(145deg,#222225 0%,#111112 100%);border-radius:20px;padding:20px;color:#fff;box-shadow:0 10px 25px rgba(0,0,0,0.15);margin-bottom:20px;max-width:320px;margin-left:auto;margin-right:auto;position:relative;overflow:hidden}
.card::after{content:'';position:absolute;top:0;left:-100%;width:50%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.1),transparent);transform:skewX(-25deg);animation:cardShine 5s infinite}
@keyframes cardShine{0%{left:-100%}20%{left:200%}100%{left:200%}}
.card-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.card-brand{font-size:12px;font-weight:800;color:#FFDD2D;letter-spacing:1.5px}
.card-chip{width:36px;height:26px;background:linear-gradient(135deg,#FFDD2D,#e6c200);border-radius:5px;margin-bottom:12px}
.card-number{font-size:16px;letter-spacing:2px;font-weight:600;margin-bottom:15px;font-family:'Courier New',monospace}
.card-bottom{display:flex;justify-content:space-between;align-items:flex-end}
.card-label{font-size:8px;color:rgba(255,255,255,0.4);text-transform:uppercase}
.card-val{font-size:11px;font-weight:700}
.balance-label{font-size:10px;color:rgba(255,255,255,0.6);margin-bottom:2px}
.balance-value{font-size:26px;font-weight:800;color:#fff;display:flex;align-items:center;gap:6px}
.balance-currency{font-size:16px;font-weight:600;color:rgba(255,255,255,0.6)}
.eye-btn{background:none;border:none;font-size:16px;cursor:pointer;padding:0 4px;opacity:0.7;color:#fff;width:auto;height:auto;margin:0}
.container{padding:0 20px;max-width:500px;margin:0 auto}
.menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px}
.menu-item{background:var(--card);border-radius:18px;padding:16px 8px;text-align:center;cursor:pointer;transition:all .15s;border:1px solid var(--border)}
.menu-item:active{transform:scale(0.96);background:rgba(0,0,0,0.05)}
.menu-icon{font-size:22px;margin:0 auto 8px}
.menu-label{font-size:11px;font-weight:700;color:var(--text)}
.block{background:var(--card);border-radius:22px;padding:20px;margin-bottom:16px;border:1px solid var(--border)}
.block-title{font-size:16px;font-weight:800;margin-bottom:14px;color:var(--text)}.list-item{display:flex;justify-content:space-between;align-items:center;padding:14px 0;border-bottom:1px solid var(--border);animation:fadeIn .2s ease}
.list-item:last-child{border-bottom:none}
.list-icon{width:44px;height:44px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:20px;margin-right:12px;background:rgba(0,0,0,0.05)}
.list-info{flex:1;text-align:left}
.list-name{font-size:14px;font-weight:700;color:var(--text)}
.list-desc{font-size:11px;color:#8a929b;margin-top:3px}
.list-price{font-size:14px;font-weight:800;color:var(--text)}
button{background:var(--accent);color:var(--text-btn);border:none;height:50px;font-size:15px;font-weight:700;border-radius:14px;cursor:pointer;width:100%;margin-top:8px;transition:all .15s;box-shadow:0 4px 15px rgba(0,0,0,0.05)}
button:active{transform:scale(0.98);box-shadow:0 0 20px var(--accent)}
button:disabled{background:rgba(0,0,0,0.1);color:#8a929b;cursor:not-allowed;box-shadow:none}
.bottom-nav{position:fixed;bottom:0;left:0;right:0;background:var(--nav-bg);border-top:1px solid var(--border);display:flex;justify-content:space-around;padding:10px 0 15px;z-index:1000}
.nav-btn{flex:1;display:flex;flex-direction:column;align-items:center;padding:6px;background:none;border:none;color:#aeb5bd;font-size:10px;font-weight:700;cursor:pointer;box-shadow:none}
.nav-btn.active{color:var(--text)}
.page{display:none;animation:fadeIn .25s ease}
.page.active{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.modal{position:fixed;inset:0;background:rgba(0,0,0,0.6);display:none;align-items:center;justify-content:center;z-index:10000;padding:20px}
.modal.active{display:flex}
.modal-box{background:var(--card);border-radius:24px;padding:24px;max-width:400px;width:100%;text-align:center;max-height:90vh;overflow-y:auto;color:var(--text);animation:zoomIn 0.2s ease forwards}
@keyframes zoomIn{0%{transform:scale(0.9);opacity:0}100%{transform:scale(1);opacity:1}}
.modal-title{font-size:20px;font-weight:800;margin-bottom:12px}
.profile-card{text-align:center;padding:20px;position:relative;border-radius:24px;background:var(--card);margin-bottom:15px;overflow:hidden}
.profile-name{font-size:22px;font-weight:900;color:var(--text);margin-bottom:4px}
.toast{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:#000;color:#fff;padding:12px 20px;border-radius:12px;font-weight:700;z-index:10001;font-size:14px;max-width:90%;text-align:center;animation:toastIn .3s}
@keyframes toastIn{from{transform:translate(-50%,-100px);opacity:0}to{transform:translate(-50%,0);opacity:1}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-5px)}75%{transform:translateX(5px)}}
.error-shake{animation:shake .4s ease;border-color:#ff3b30!important}
.p-avatar{position:relative;width:120px;height:120px;margin:0 auto 15px;display:flex;align-items:center;justify-content:center}
.p-avatar .ava-core{width:92px;height:92px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;font-size:46px;border:4px solid #fff;box-shadow:0 10px 20px rgba(0,0,0,0.1);position:relative;z-index:3;overflow:hidden;animation:breathe 3s infinite}
.p-avatar .frame-ring{position:absolute;inset:0;border-radius:50%;pointer-events:none;z-index:2}
.p-avatar .bg-ring{position:absolute;inset:-14px;border-radius:50%;pointer-events:none;z-index:1;opacity:0.85}
.p-avatar .fx-layer{position:absolute;inset:-30px;pointer-events:none;z-index:4}
@keyframes breathe{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
.frame-bronze{border:4px solid #cd7f32;box-shadow:0 0 10px #cd7f32}
.frame-silver{border:4px solid #c0c0c0;box-shadow:0 0 15px #c0c0c0;animation:pulseSilver 2s infinite}
@keyframes pulseSilver{0%,100%{box-shadow:0 0 10px #c0c0c0}50%{box-shadow:0 0 25px #c0c0c0}}
.frame-gold{border:4px dashed #FFD700;animation:spin 6s linear infinite;box-shadow:0 0 20px #FFD700}
@keyframes spin{100%{transform:rotate(360deg)}}
.frame-crystal{border:4px solid #7fffd4;box-shadow:0 0 25px #7fffd4,inset 0 0 15px #7fffd4;animation:shimmer 2s infinite}
@keyframes shimmer{0%,100%{opacity:1}50%{opacity:0.6}}
.frame-fire{border:4px solid #ff4500;box-shadow:0 0 25px #ff4500;animation:firePulse 1s infinite}
@keyframes firePulse{0%,100%{box-shadow:0 0 15px #ff4500;transform:scale(1)}50%{box-shadow:0 0 40px #ff8c00;transform:scale(1.05)}}
.frame-electric{border:4px solid #00bfff;box-shadow:0 0 30px #00bfff;animation:electric 0.5s infinite}
@keyframes electric{0%,100%{box-shadow:0 0 20px #00bfff;border-color:#00bfff}50%{box-shadow:0 0 50px #00ffff;border-color:#00ffff}}
.frame-space{border:4px solid #4b0082;box-shadow:0 0 30px #8a2be2;animation:space 3s infinite}
@keyframes space{0%,100%{box-shadow:0 0 20px #4b0082}50%{box-shadow:0 0 50px #da70d6}}
.frame-rainbow{border:4px solid;border-image:linear-gradient(45deg,red,orange,yellow,green,blue,indigo,violet) 1;animation:rainbow 3s linear infinite;box-shadow:0 0 30px rgba(255,0,255,0.5)}
@keyframes rainbow{0%{filter:hue-rotate(0)}100%{filter:hue-rotate(360deg)}}
.frame-royal{border:4px solid #FFD700;box-shadow:0 0 40px #FFD700,inset 0 0 20px #FFD700;animation:royal 2s infinite}
@keyframes royal{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
.frame-dragon{border:4px solid #8b0000;box-shadow:0 0 40px #ff0000,inset 0 0 20px #ff4500;animation:dragon 1.5s infinite}
@keyframes dragon{0%,100%{box-shadow:0 0 30px #8b0000}50%{box-shadow:0 0 70px #ff0000,inset 0 0 30px #ff4500}}
.frame-legend{border:4px solid #FFD700;box-shadow:0 0 60px #FFD700,0 0 100px #ff00ff,inset 0 0 30px #FFD700;animation:legend 2s infinite}
@keyframes legend{0%,100%{filter:brightness(1) hue-rotate(0)}50%{filter:brightness(1.5) hue-rotate(180deg)}}
.bg-space{background:radial-gradient(circle,#1a0033,#000);box-shadow:0 0 40px #8a2be2}
.bg-ocean{background:linear-gradient(180deg,#0077be,#00bfff)}
.bg-fire{background:linear-gradient(180deg,#ff4500,#ffd700);box-shadow:0 0 30px #ff4500}
.bg-rainbow{background:linear-gradient(90deg,red,orange,yellow,green,blue,indigo,violet);animation:rainbow 3s linear infinite}
.bg-gold{background:linear-gradient(180deg,#FFD700,#b8860b);box-shadow:0 0 40px #FFD700}
.fx-sparks::before,.fx-sparks::after{content:'✨';position:absolute;font-size:18px;animation:orbit 4s linear infinite}
.fx-sparks::after{animation-direction:reverse;font-size:14px}
@keyframes orbit{0%{transform:rotate(0) translateX(60px) rotate(0)}100%{transform:rotate(360deg) translateX(60px) rotate(-360deg)}}
.fx-snow::before,.fx-snow::after{content:'❄️';position:absolute;font-size:16px;animation:orbit 6s linear infinite}
.fx-snow::after{animation-direction:reverse}
.fx-coins::before,.fx-coins::after{content:'💰';position:absolute;font-size:16px;animation:orbit 4s linear infinite}
.fx-coins::after{animation-direction:reverse}
.fx-stars::before,.fx-stars::after{content:'⭐';position:absolute;font-size:16px;animation:orbit 5s linear infinite}
.fx-stars::after{animation-direction:reverse}
.style-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px}
.style-card{background:rgba(0,0,0,0.05);border-radius:14px;padding:10px;text-align:center;cursor:pointer;border:2px solid transparent;transition:all .15s}
.style-card.active{border-color:#00c853;background:rgba(0,200,83,0.1)}
.style-card .sc-icon{font-size:26px;margin-bottom:4px}
.style-card .sc-name{font-size:10px;font-weight:700}
.style-card .sc-price{font-size:9px;color:#8a929b;margin-top:2px}
.prem-card{background:rgba(0,0,0,0.05);border-radius:16px;padding:14px;margin-bottom:10px;border:2px solid transparent}
.prem-card.active{border-color:#FFD700;background:rgba(255,215,0,0.1)}
.prem-title{font-size:15px;font-weight:800}
.prem-desc{font-size:11px;color:#8a929b;margin:4px 0}
.lvl-bar{background:rgba(0,0,0,0.1);border-radius:10px;height:10px;overflow:hidden;margin:6px 0}
.lvl-fill{height:100%;background:linear-gradient(90deg,#00c853,var(--accent));transition:width .3s}
.nick-rainbow{background:linear-gradient(90deg,red,orange,yellow,green,blue,indigo,violet);-webkit-background-clip:text;background-clip:text;color:transparent;animation:rainbow 3s linear infinite}
.nick-glow{text-shadow:0 0 10px #FFD700,0 0 20px #FFD700;animation:pulseSilver 2s infinite}
.nick-bold{font-weight:900}
.nick-italic{font-style:italic}
.nick-mono{font-family:'Courier New',monospace}
.nick-hand{font-family:'Comic Sans MS',cursive}
.nick-serif{font-family:Georgia,serif}
</style>
</head><body>

<div class="demo-banner">Демонстрационная версия. Не является финансовым приложением.</div>

<!-- РЕГИСТРАЦИЯ -->
<div class="screen active" id="reg-step1">
  <div class="reg-box" style="animation: modalPop 0.4s ease">
    <div class="reg-logo" style="font-size:50px;margin-bottom:10px;animation: float 3s infinite">💎</div>
    <div class="reg-title">БелКристаллБанк</div>
    <div class="reg-hint">Добро пожаловать! Введите номер телефона, чтобы начать.</div>
    <div style="font-size:12px;color:#8a929b;margin-bottom:5px;text-align:left;padding-left:5px">Телефон:</div>
    <input type="tel" class="reg-input" id="reg-phone" placeholder="+7 (___) ___-__-__" oninput="formatPhone(this)">
    <label style="display:flex;align-items:center;gap:8px;margin:10px 0 20px;cursor:pointer;text-align:left">
      <input type="checkbox" id="reg-agree" style="width:18px;height:18px;accent-color:var(--accent)">
      <span style="font-size:12px;color:#8a929b">Я согласен с правилами игры</span>
    </label>
    <button class="reg-btn" onclick="regNext(1)">Продолжить</button>
  </div>
</div>

<div class="screen" id="reg-step2">
  <div class="reg-box" style="animation: modalPop 0.4s ease">
    <div class="reg-logo" style="font-size:50px;margin-bottom:10px">📱</div>
    <div class="reg-title">Введите код</div>
    <div class="reg-hint">Мы отправили код на номер <br><b id="reg-phone-display" style="color:var(--text)">+7...</b></div>
    <input type="tel" class="reg-input" id="reg-code" placeholder="• • • •" maxlength="4" style="font-size:24px;letter-spacing:10px;text-align:center">
    <button class="reg-btn" onclick="regNext(2)">Подтвердить</button>
    <button class="reg-btn" onclick="regNext(0)" style="background:transparent;color:#8a929b;box-shadow:none;margin-top:5px;font-size:13px">Назад</button>
  </div>
</div>

<div class="screen" id="reg-step3">
  <div class="reg-box" style="animation: modalPop 0.4s ease">
    <div class="reg-logo" style="font-size:50px;margin-bottom:10px">👤</div>
    <div class="reg-title">Создание профиля</div>
    <div class="reg-hint">Придумайте ник (мин. 5 букв) и пароль.</div>
    <div style="font-size:12px;color:#8a929b;margin-bottom:5px;text-align:left;padding-left:5px">Ваш ник:</div>
    <input type="text" class="reg-input" id="reg-name" placeholder="Например: TonyStark" oninput="checkNick(this)">
    <div id="nick-error" style="color:#ff3b30;font-size:11px;text-align:left;padding-left:5px;margin-bottom:10px;display:none">Ник должен быть не короче 5 букв</div>
    <div style="font-size:12px;color:#8a929b;margin-bottom:5px;text-align:left;padding-left:5px">Пароль:</div>
    <input type="password" class="reg-input" id="reg-pass" placeholder="••••••••">
    <button class="reg-btn" onclick="finishReg()" style="margin-top:20px">Создать аккаунт</button>
    <button class="reg-btn" onclick="regNext(1)" style="background:transparent;color:#8a929b;box-shadow:none;margin-top:5px;font-size:13px">Назад</button>
  </div>
</div>

<!-- ПРИЛОЖЕНИЕ -->
<div id="app-screen" style="display:none">
  <div class="header">
    <div class="header-top">
      <div class="logo"><div class="logo-icon">Б</div><span>БелКристаллБанк</span></div>
      <div class="user-icon" onclick="openProfile()" id="user-icon-mini">👤</div>
    </div>
  </div>

  <div class="page active" id="page-home">
    <div class="container">
      <div class="card" onclick="openCard()">
        <div class="card-top"><div class="card-brand">БЕЛКРИСТАЛЛ</div><div class="card-logo">💎</div></div>
        <div style="margin-bottom:15px"><div class="balance-label">Баланс</div>
          <div class="balance-value"><span id="balance">0</span><span class="balance-currency">₽</span>
          <button class="eye-btn" onclick="toggleBalance(event)" id="eye-btn">👁️</button></div></div>
        <div class="card-chip"></div>
        <div class="card-number" id="card-number">0000 0000 0000 0000</div>
        <div class="card-bottom">
          <div><div class="card-label">Владелец</div><div class="card-val" id="card-owner">PRESIDENT</div></div>
          <div><div class="card-label">Срок</div><div class="card-val" id="card-expiry">15/98</div></div>
        </div>
      </div>

      <div class="menu-grid">
        <div class="menu-item" onclick="switchPage('tasks')"><div class="menu-icon">🎯</div><div class="menu-label">Задания</div></div>
        <div class="menu-item" onclick="switchPage('work')"><div class="menu-icon">👷</div><div class="menu-label">Работа</div></div>
        <div class="menu-item" onclick="switchPage('docs')"><div class="menu-icon">📄</div><div class="menu-label">Документы</div></div>
        <div class="menu-item" onclick="switchPage('credit')"><div class="menu-icon">🏦</div><div class="menu-label">Кредит</div></div>
        <div class="menu-item" onclick="switchPage('social')"><div class="menu-icon">📱</div><div class="menu-label">Соцсети</div></div>
        <div class="menu-item" onclick="switchPage('currency')"><div class="menu-icon">💱</div><div class="menu-label">Валюта</div></div>
        <div class="menu-item" onclick="switchPage('styles')"><div class="menu-icon">✨</div><div class="menu-label">Стили</div></div>
        <div class="menu-item" onclick="switchPage('premium')"><div class="menu-icon">💎</div><div class="menu-label">Премиум</div></div>
        <div class="menu-item" onclick="switchPage('court')"><div class="menu-icon">⚖️</div><div class="menu-label">Суд</div></div>
        <div class="menu-item" onclick="switchPage('casino')"><div class="menu-icon">🎰</div><div class="menu-label">Казино</div></div>
        <div class="menu-item" onclick="switchPage('cars')"><div class="menu-icon">🚗</div><div class="menu-label">Авто</div></div>
        <div class="menu-item" onclick="switchPage('houses')"><div class="menu-icon">🏠</div><div class="menu-label">Дома</div></div>
        <div class="menu-item" onclick="switchPage('business')"><div class="menu-icon">💼</div><div class="menu-label">Бизнес</div></div>
        <div class="menu-item" onclick="switchPage('cases')"><div class="menu-icon">📦</div><div class="menu-label">Кейсы</div></div>
