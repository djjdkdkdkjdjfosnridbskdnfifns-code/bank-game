function toast(msg){
  const box=document.getElementById('toast-box');
  if(!box) return;
  const t=document.createElement('div'); t.className='toast'; t.textContent=msg;
  const isError = /(Нет|Недостаточно|Нужно|Провал|Ошибка|не так|отказ|заблокировано|мало)/i.test(msg);
  t.style.background = isError ? '#ff3b30' : (msg.includes('🎉')||msg.includes('Куплено')||msg.includes('+')||msg.includes('выигран') ? '#00c853' : '#000');
  box.appendChild(t); setTimeout(()=>t.remove(),2500);
}
function coinFly(){ const c=document.createElement('div'); c.className='coin-fly'; c.textContent='💰'; c.style.left='50%'; c.style.top='120px'; document.body.appendChild(c); setTimeout(()=>c.remove(),1000); }
function confetti(){ for(let i=0;i<20;i++){ const d=document.createElement('div'); d.className='confetti'; d.style.left=Math.random()*100+'vw'; d.style.background=['#FFDD2D','#00c853','#a855f7'][i%3]; document.body.appendChild(d); setTimeout(()=>d.remove(),2000); } }
function addHistory(text, amount){ S.history.unshift({ text, amount, time:new Date().toLocaleTimeString('ru-RU') }); if(S.history.length>50) S.history.pop(); }
function changeBalance(delta){
  S.balance=Math.max(0,S.balance+delta);
  addHistory(delta>=0?'Пополнение':'Списание', delta);
  if(delta > 0) { for(let i=0; i<3; i++) { setTimeout(() => coinFly(), i * 100); } }
  updateUI(); save();
}
function premiumBonus(){ if(!S.premiumLevel || Date.now()>S.premiumUntil) return {salary:0,energy:0,discount:0,daily:1,badge:''}; const p=PREMIUM_LEVELS.find(x=>x.level===S.premiumLevel); return p?{salary:p.salaryBonus,energy:p.energyBonus,discount:p.discount,daily:p.dailyMul,badge:p.badge}:{salary:0,energy:0,discount:0,daily:1,badge:''}; }
function calcLimit(){ S.creditLimit = WORK_JOBS.reduce((a,j)=>a+j.pay,0)*10; }
function xpForLevel(lvl){ return lvl*50; }
function getWealth(){
  let w = S.balance + (S.usd*S.rates.usd) + (S.eur*S.rates.eur) + (S.kzt*S.rates.kzt);
  S.ownedCars.forEach(i=>{ if(CARS[i]) w+=CARS[i].price; });
  S.ownedHouses.forEach(i=>{ if(HOUSES[i]) w+=HOUSES[i].price; });
  S.ownedBusiness.forEach(id=>{ const b=BUSINESS.find(x=>x.id===id); if(b) w+=b.price; });
  S.collection.forEach(id=>{ const it=ITEMS.find(x=>x.id===id); if(it) w+=it.price; });
  const debt = S.credits.reduce((a,c)=>a+c.remaining,0);
  w -= debt;
  return Math.max(0, Math.floor(w));
}

function formatPhone(input) {
  let val = input.value.replace(/\D/g, '');
  if (val.length > 11) val = val.slice(0, 11);
  let res = '';
  if (val.length > 0) res = '+7';
  if (val.length > 1) res += ' (' + val.slice(1, 4);
  if (val.length > 4) res += ') ' + val.slice(4, 7);
  if (val.length > 7) res += '-' + val.slice(7, 9);
  if (val.length > 9) res += '-' + val.slice(9, 11);
  input.value = res;
}
function checkNick(input) {
  const err = document.getElementById('nick-error');
  const letters = (input.value.match(/[a-zA-Zа-яА-ЯёЁ]/g)||[]).length;
  if (letters > 0 && letters < 5) { err.style.display = 'block'; input.style.borderColor = '#ff3b30'; } 
  else { err.style.display = 'none'; input.style.borderColor = 'var(--border)'; }
}
